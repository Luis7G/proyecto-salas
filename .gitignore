!.vscode/launch.json
!.vscode/extensions.json

# WebStorm/IntelliJ
.idea/
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# === SISTEMAS OPERATIVOS ===
