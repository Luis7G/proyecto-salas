.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# === LOGS ===
# Archivos de log
logs/
*.log
lerna-debug.log*

# === RUNTIME DATA ===
# Archivos de proceso
pids/
*.pid
*.seed
*.pid.lock

